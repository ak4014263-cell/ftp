# Database Configuration
POSTGRES_USER=swiply
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=swiply

# Database URLs (auto-constructed from above)
DATABASE_URL=postgresql://swiply:CHANGE_ME_STRONG_PASSWORD@postgres:5432/swiply
REDIS_URL=redis://redis:6379/0

# API Keys
OPENAI_API_KEY=your-openai-api-key-here

# Stripe Payment Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_PRICE_ID=your-stripe-price-id-here
STRIPE_PRODUCT_ID=your-stripe-product-id-here
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://www.swiply.io

# Admin Panel Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
ADMIN_USERNAME=admin@swiply.io

# Security
ENCRYPTION_KEY=your-32-byte-encryption-key-here-must-be-32-chars

# Frontend Configuration
VITE_API_URL=https://www.swiply.io/api

# Automation Settings for VPS
HEADLESS=true

# CRITICAL: Proxy Settings (Required to prevent IP blocking)
# Get these from Bright Data, Smartproxy, or Oxylabs
PROXY_ENABLED=true
PROXY_HOST=brd.superproxy.io
PROXY_PORT=22225
PROXY_USERNAME=your-proxy-username
PROXY_PASSWORD=your-proxy-password

# Rate Limiting (Prevent IP blocking)
RATE_LIMIT_PER_HOUR=20

# Session Persistence (Maintain browser sessions)
SESSION_PERSISTENCE_ENABLED=true

# Optional: Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Optional: Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
